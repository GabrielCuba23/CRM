# Copiar a .env.retail en el servidor y proteger con chmod 600.
# Reemplazar los dominios por los tuyos; necesitan DNS y HTTPS reales.
RETAIL_PUBLIC_URL=https://admin.example.com
RETAIL_BASE_DOMAIN=clients.example.com
RETAIL_DATA_ROOT=/data/retail
RETAIL_ADMIN_EMAIL=
# La contraseña inicial se define de forma privada, mínimo 12 caracteres.
RETAIL_ADMIN_PASSWORD=
