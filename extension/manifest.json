{
  "manifest_version": 3,
  "name": "Nexo CRM para WhatsApp Web",
  "description": "Clientes, fichas y cuentas junto al chat de WhatsApp: servicios, perfiles, renovaciones y mensajes conectados con tu CRM.",
  "version": "1.2.1",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "clipboardWrite", "offscreen"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_title": "Abrir Nexo CRM" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "192": "app/app-icon-192.png", "512": "app/app-icon-512.png" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp.js", "dock.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["app/*", "bootstrap.mjs", "companion.css"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
  }
}
